# Lammps input to run Si4Ge4

##########################
#     Initialization     #
##########################
log Si4Ge4_3.log
units metal
boundary p p p
atom_style atomic
read_data /home/pomax/scratchdir/SiGe_lammps_ref/Si4Ge4.in
mass 1 28.085
mass 2 72.630
group Si type 1
group Ge type 2

#######################
#     Interaction     #
#######################
pair_style sw
pair_coeff * * /home/pomax/Data/Potential/SiGe.sw Si Ge



######################
#     Thermostat     #
######################
timestep 0.001  # 1 fs
velocity all create 300.0 12347 mom yes rot no dist gaussian
fix f1 all nvt temp 300 300 $(100*dt)
fix fcm all recenter INIT INIT INIT


run 10000
thermo 1
dump last all custom 100 Si4Ge4_3.dump id type xu yu zu vx vy vz fx fy fz element
run 10000
