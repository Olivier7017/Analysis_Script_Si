# Lammps input to run Si216

##########################
#     Initialization     #
##########################
log Si216_4.log
units metal
boundary p p p
atom_style atomic
read_data /home/pomax/scratchdir/Si_lammps_ref/Si216.in
mass 1  28.085
group Si type 1

#######################
#     Interaction     #
#######################
pair_style sw
pair_coeff * * /home/pomax/scratchdir/Si_lammps_ref/Si.sw Si



######################
#     Thermostat     #
######################
timestep 0.001  # 1 fs
velocity all create 300.0 12348 mom yes rot no dist gaussian
fix f1 all nvt temp 300 300 $(100*dt)
fix fcm all recenter INIT INIT INIT


run 10000
thermo 1
dump last all custom 100 Si216_4.dump id type xu yu zu vx vy vz fx fy fz element
run 10000
